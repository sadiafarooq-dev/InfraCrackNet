SECRET_KEY=change-this-to-something-random

# --- Real email sending for Forgot Password (optional) ---
# Without these 2 lines filled in, Forgot Password still works exactly
# like before -- it just shows the reset link on-screen instead of really
# emailing it. To make it send a real email:
#   1. Turn on 2-Step Verification on your Google account, if it isn't on
#      already: https://myaccount.google.com/security
#   2. Generate an "App Password" here: https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app -- it gives you a 16-character code)
#   3. Copy this whole file to a new file named exactly ".env" (same
#      folder), and paste your real Gmail address and that 16-character
#      App Password below -- NOT your real Gmail password.
#   4. Restart the app.
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
